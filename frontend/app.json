{
  "expo": {
    "name": "Animal Husbandry UP",
    "slug": "animal-husbandry-up",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "animalhusbandryup",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.govrefapp.animalhusbandry",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos for reference application",
        "NSPhotoLibraryUsageDescription": "Upload documents for verification"
      }
    },
    "android": {
      "package": "com.govrefapp.animalhusbandry",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF9933"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FF9933"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Animal Husbandry app to access camera for capturing photos"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Animal Husbandry app to access photos for document upload"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
