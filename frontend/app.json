{
  "expo": {
    "name": "Gau Seva",
    "slug": "gau-seva",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gauseva",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gauseva.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos for reference application",
        "NSPhotoLibraryUsageDescription": "Upload documents for verification"
      }
    },
    "android": {
      "package": "com.gauseva.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF9933"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Gau Seva",
      "shortName": "Gau Seva",
      "description": "Government of Uttar Pradesh - Animal Husbandry Department",
      "lang": "en-IN",
      "themeColor": "#FF9933",
      "backgroundColor": "#FF9933",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FF9933"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Gau Seva app to access camera for capturing photos"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Gau Seva app to access photos for document upload"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
